# Choose one Gemini authentication mode.

# Option A: Google AI Studio (easiest local setup)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=replace-with-your-google-ai-studio-key

# Option B: Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Required for live location intelligence
GOOGLE_PLACES_API_KEY=replace-with-your-google-places-key

# Override when a different Gemini model is preferred.
MODEL_NAME=gemini-3.5-flash

# Search defaults
DEFAULT_RADIUS_METERS=1600
MAX_PLACE_RESULTS=20

